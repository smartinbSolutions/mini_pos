      "frontend/build/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "keywords": [],
  "author": {
    "name": "DevZeroSh",
    "email": "m.shahrour.work@gmail.com"
  },
  "license": "MIT",
